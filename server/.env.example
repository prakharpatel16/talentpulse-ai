# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Database
# Use a local MongoDB URI for development; production requires a durable MongoDB URI.
MONGODB_URI=mongodb://localhost:27017/talentpulse

# Redis (required for BullMQ jobs; cache reads fall back to MongoDB if Redis is down)
REDIS_URL=redis://localhost:6379

# Optional shared upload directory; defaults to server/uploads
# Set to the persistent disk path when deploying API and worker together.
UPLOAD_DIR=

# AI Services (Google Gemini)
# Without a Gemini key, AI analysis is marked unavailable and hiring stays a human decision.
GEMINI_API_KEY=

# Reserved for future object-storage integration. Uploads currently use UPLOAD_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
